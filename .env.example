# Copia este archivo a .env si tu MCP necesita configuracion.
# NUNCA subas el archivo .env a git (ya esta en .gitignore).

# Lista de aplicaciones que el MCP puede abrir (separadas por coma).
# Si esta vacia, se permite cualquier aplicacion instalada.
MCP_ALLOWED_APPS=

# Ejemplo de clave de API para un MCP que llame a un servicio externo
# MI_API_KEY=
