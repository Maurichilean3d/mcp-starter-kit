{
  "name": "mcp-starter-kit",
  "version": "1.1.1",
  "description": "Plantilla base para construir servidores MCP (Model Context Protocol) y usarlos con opencode, Claude Desktop, Cursor y otros clientes.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-starter-kit": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "crear-mcp": "node constructor/servidor.mjs",
    "new-tool": "node scripts/new-tool.mjs",
    "configurar": "node scripts/configurar-opencode.mjs",
    "configurar:global": "node scripts/configurar-opencode.mjs --global",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "setup": "node instalador/setup.mjs",
    "construir-instaladores": "node instalador/construir.mjs",
    "diagnostico": "node scripts/diagnostico.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "starter"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
